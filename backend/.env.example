# Copiez ces variables dans votre environnement avant de lancer le serveur PHP.
# PowerShell (Windows) :   $env:DB_NOM="gestion_finances"
# Bash (Linux/Mac) :       export DB_NOM=gestion_finances

DB_HOTE=localhost
DB_NOM=gestion_finances
DB_UTILISATEUR=root
DB_MOT_DE_PASSE=

# Origine(s) du frontend autorisée(s) à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:5173
